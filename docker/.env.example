# Copy to .env next to compose.yaml and fill in. Rules files can use any of these as ${VAR}.

# -- a provider key (one is enough) ---------------------------------------------------------
# Gemini: free tier at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# TypeSafe Jev (images, fastest)
TYPESAFE_API_KEY=
# OPENAI_API_KEY=
# AZURE_DECISION_ENDPOINT=
# AZURE_DECISION_KEY=

# -- used by rules/doorbell.yaml ------------------------------------------------------------
# A camera snapshot URL: Frigate (http://frigate:5000/api/front_door/latest.jpg), most IP
# cameras, or Home Assistant (http://homeassistant.local:8123/api/camera_proxy/camera.front_door
# with HA_TOKEN set to a long-lived access token).
DOORBELL_SNAPSHOT_URL=http://192.168.1.50/snapshot.jpg
# HA_TOKEN=
# Pick a hard-to-guess topic and subscribe to it in the ntfy app.
NTFY_TOPIC=ifseen-doorbell-change-me

# -- ifseen serve ---------------------------------------------------------------------------
# Extra flags, e.g. --dry-run (random probabilities, no key needed, actions only logged).
IFSEEN_SERVE_ARGS=
# Needed only if you publish port 8899 (see compose.yaml); 16+ characters.
# IFSEEN_TOKEN=
