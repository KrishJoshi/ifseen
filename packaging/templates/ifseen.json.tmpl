{
    "version": "$version",
    "description": "Plain-English triggers for your screen, camera and mic, powered by decision models",
    "homepage": "https://krishj.com/ifseen/",
    "license": "MIT",
    "notes": "Standalone build: screen, camera, mic and MQTT included. For the free offline 'local' provider (torch), use: pipx install \"ifseen[all,local]\"",
    "architecture": {
        "64bit": {
            "url": "$base_url/ifseen-$version-windows-x86_64.zip",
            "hash": "$sha_windows_x86_64"
        }
    },
    "bin": "ifseen.exe",
    "checkver": {
        "github": "https://github.com/$repo"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/$repo/releases/download/v$$version/ifseen-$$version-windows-x86_64.zip"
            }
        },
        "hash": {
            "url": "$$baseurl/SHA256SUMS"
        }
    }
}
