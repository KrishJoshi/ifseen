# Generated by packaging/make_release_files.py for ifseen $version - commit to
# github.com/KrishJoshi/homebrew-tap as Formula/ifseen.rb.
class Ifseen < Formula
  desc "Plain-English triggers for your screen, camera and mic, powered by decision models"
  homepage "https://krishj.com/ifseen/"
  version "$version"
  license "MIT"

  on_macos do
    on_arm do
      url "$base_url/ifseen-$version-macos-arm64.tar.gz"
      sha256 "$sha_macos_arm64"
    end
    on_intel do
      url "$base_url/ifseen-$version-macos-x86_64.tar.gz"
      sha256 "$sha_macos_x86_64"
    end
  end

  on_linux do
    on_arm do
      url "$base_url/ifseen-$version-linux-arm64.tar.gz"
      sha256 "$sha_linux_arm64"
    end
    on_intel do
      url "$base_url/ifseen-$version-linux-x86_64.tar.gz"
      sha256 "$sha_linux_x86_64"
    end
  end

  def install
    bin.install "ifseen"
  end

  def caveats
    <<~EOS
      Standalone build: screen, camera, mic and MQTT included. For the free offline
      `local` provider (torch), install with pipx instead: pipx install "ifseen[all,local]"
    EOS
  end

  test do
    assert_match "ifseen #{version}", shell_output("#{bin}/ifseen --version")
    assert_match "doorbell", shell_output("#{bin}/ifseen recipes")
  end
end
